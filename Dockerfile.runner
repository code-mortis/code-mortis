ARG DOCKERHUB_REGISTRY=docker.io
FROM ${DOCKERHUB_REGISTRY}/library/node:24.11.0-bookworm-slim AS clients
RUN npm install --global --no-audit --no-fund @openai/codex@0.160.1 @anthropic-ai/claude-code@2.1.292

FROM ${DOCKERHUB_REGISTRY}/library/python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
COPY --from=clients /usr/local/ /usr/local/
COPY --from=ghcr.io/astral-sh/uv:0.9.14 /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/code_mortis/ ./code_mortis/
COPY backend/tests/native_runner_smoke.py ./tests/native_runner_smoke.py
RUN groupadd -g 10001 mortis && useradd -u 10001 -g mortis -m mortis && mkdir /profiles && chown mortis:mortis /profiles
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER mortis
CMD ["uvicorn", "code_mortis.native_runner:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
