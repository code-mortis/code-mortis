      "refersTo": "button-primary",
      "description": "Main action.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Resolve finding</button>",
      "css": ".ds-button-primary{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary, #245944);color:var(--primary-foreground, #ffffff);}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary, #245944) 90%,transparent);}.ds-button-primary:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-button-primary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:0.01ms;animation-duration:0.01ms;}}"
