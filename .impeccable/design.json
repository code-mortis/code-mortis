      "css": ".ds-button-ghost{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:transparent;color:var(--foreground, #202c26);}.ds-button-ghost:hover{background:var(--accent, #e1ebe2);color:var(--accent-foreground, #173e2a);}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-button-ghost:disabled{pointer-events:none;opacity:.5;}:host-context(.dark) .ds-button-ghost:hover{background:color-mix(in oklab,var(--accent, #e1ebe2) 50%,transparent);}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition-duration:0.01ms;animation-duration:0.01ms;}}"
    },
    {
