      "refersTo": "button-secondary",
      "description": "Available generated primitive; not currently used by application screens.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Secondary action</button>",
      "css": ".ds-button-secondary{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--secondary, #e9eee8);color:var(--secondary-foreground, #254533);}.ds-button-secondary:hover{background:color-mix(in oklab,var(--secondary, #e9eee8) 80%,transparent);}.ds-button-secondary:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-button-secondary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition-duration:0.01ms;animation-duration:0.01ms;}}"
