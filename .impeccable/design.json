      "kind": "button",
      "refersTo": "button-link",
      "description": "Available generated primitive; not currently used by application screens.",
      "html": "<button type=\"button\" class=\"ds-button-link\">View details</button>",
      "css": ".ds-button-link{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:transparent;color:var(--primary, #245944);text-underline-offset:4px;}.ds-button-link:hover{text-decoration:underline;}.ds-button-link:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-button-link:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-link{transition-duration:0.01ms;animation-duration:0.01ms;}}"
    },
    {
      "name": "Text input",
      "kind": "input",
      "refersTo": "input",
      "description": "Standard labeled input, preserving larger text below 768px.",
      "html": "<label class=\"ds-field-label\" for=\"ds-model\">Model identifier</label><input class=\"ds-input\" id=\"ds-model\" placeholder=\"Provider model ID\">",
      "css": ".ds-field-label{font-family:'Inter Variable',sans-serif;display:block;margin-bottom:8px;font-size:14px;line-height:1;font-weight:500;color:var(--foreground, #202c26);}.ds-input{font-family:'Inter Variable',sans-serif;height:36px;width:100%;min-width:0;padding:4px 12px;border:1px solid var(--input, #c5cec3);border-radius:var(--radius,8px);background:transparent;color:var(--foreground, #202c26);font-size:16px;line-height:24px;box-shadow:0 1px 2px 0 rgb(0 0 0 / .05);transition:color 150ms cubic-bezier(.4,0,.2,1),box-shadow 150ms cubic-bezier(.4,0,.2,1);}.ds-input::placeholder{color:var(--muted-foreground, #606a62);}.ds-input:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-input:disabled{pointer-events:none;cursor:not-allowed;opacity:.5;}.ds-input[aria-invalid=true]{border-color:var(--destructive, #b32d37);box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive, #b32d37) 20%,transparent);}:host-context(.dark) .ds-input{background:color-mix(in oklab,var(--input, #c5cec3) 30%,transparent);}@media(min-width:768px){.ds-input{font-size:14px;line-height:20px;}}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:0.01ms;animation-duration:0.01ms;}}"
    },
    {
      "name": "Native select",
      "kind": "input",
      "refersTo": "native-select",
      "description": "Compact browser-native filter.",
      "html": "<select class=\"ds-select\" aria-label=\"Finding status\"><option>Open findings</option><option>Resolved findings</option><option>All findings</option></select>",
      "css": ".ds-select{font-family:'Inter Variable',sans-serif;height:36px;width:160px;padding:0 12px;border:1px solid var(--input, #c5cec3);border-radius:var(--radius,8px);background:var(--card, #ffffff);color:var(--foreground, #202c26);font-size:14px;line-height:20px;cursor:pointer;}.ds-select:focus-visible{outline:2px solid var(--ring, #377c59);outline-offset:3px;}.ds-select:disabled{opacity:.5;}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Theme-matching shadcn sidebar with filled selection, owner/name repository labels, and visible running activity. The 256px desktop sidebar hides fully; below 1024px it opens as a 288px drawer. This preview shows the navigation rows.",
      "html": "<nav class=\"ds-sidebar\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#inbox\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg><span>Inbox</span></a><p class=\"ds-nav-group\">Repositories</p><a class=\"ds-nav-link ds-nav-repository\" href=\"#repositories\" aria-current=\"page\" aria-label=\"acme/payments, review running\" title=\"acme/payments\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5\"/><circle cx=\"13\" cy=\"12\" r=\"2\"/><path d=\"M18 19c-2.8 0-5-2.2-5-5v8\"/><circle cx=\"20\" cy=\"19\" r=\"2\"/></svg><span class=\"ds-nav-identity\"><span class=\"ds-nav-name\">payments</span><span class=\"ds-nav-owner\">acme</span></span><span class=\"ds-nav-running\"><svg class=\"ds-nav-spinner\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/></svg>Running</span></a></nav>",
      "css": ".ds-sidebar{box-sizing:border-box;width:256px;max-width:100%;padding:16px;background:var(--sidebar,var(--muted,#eef0ec));color:var(--sidebar-foreground,var(--foreground,#202c26));font-family:'Inter Variable',sans-serif;}.ds-nav-link{box-sizing:border-box;display:flex;align-items:center;gap:8px;height:40px;padding:8px;border-radius:var(--radius,8px);font-size:14px;line-height:20px;color:inherit;text-decoration:none;}.ds-nav-link>svg{flex-shrink:0;}.ds-nav-link:hover,.ds-nav-link:active,.ds-nav-link[aria-current=page]{background:var(--sidebar-accent,var(--accent,#e1ebe2));color:var(--sidebar-accent-foreground,var(--accent-foreground,#173e2a));}.ds-nav-link[aria-current=page]{font-weight:500;}.ds-nav-link:focus-visible{outline:none;box-shadow:0 0 0 2px var(--sidebar-ring,var(--ring,#377c59));}.ds-nav-group{margin:24px 0 0;padding:8px;font-size:12px;line-height:16px;font-weight:500;color:var(--muted-foreground,#606a62);}.ds-nav-repository{height:48px;}.ds-nav-repository>svg,.ds-nav-owner{color:var(--muted-foreground,#606a62);}.ds-nav-identity{min-width:0;flex:1;}.ds-nav-name,.ds-nav-owner{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}.ds-nav-name{font-weight:500;}.ds-nav-owner{font-size:12px;line-height:16px;}.ds-nav-running{display:flex;align-items:center;gap:4px;flex-shrink:0;font-size:12px;line-height:16px;color:var(--sidebar-primary,var(--primary,#245944));}@media(prefers-reduced-motion:no-preference){.ds-nav-spinner{animation:ds-sidebar-spin 1s linear infinite;}}@keyframes ds-sidebar-spin{to{transform:rotate(360deg);}}"
    },
    {
      "name": "Semantic status chips",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "State labels use text plus restrained emerald, red, or amber tints.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-chip ds-good\">Resolved</span><span class=\"ds-chip ds-danger\">High</span><span class=\"ds-chip ds-caution\">Partial</span><span class=\"ds-chip\">Open</span></div>",
      "css": ".ds-statuses{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:2px 8px;border:1px solid var(--border, #dce1d9);border-radius:9999px;color:var(--foreground, #202c26);font-size:12px;line-height:16px;font-weight:500;white-space:nowrap;text-transform:capitalize;}.ds-good{background:color-mix(in oklab,oklch(50.8% 0.118 165.612) 8%,transparent);border-color:color-mix(in oklab,oklch(50.8% 0.118 165.612) 20%,transparent);color:oklch(43.2% 0.095 166.913);}:host-context(.dark) .ds-good{color:oklch(84.5% 0.143 164.978);}.ds-danger{background:color-mix(in oklab,oklch(57.7% 0.245 27.325) 8%,transparent);border-color:color-mix(in oklab,oklch(57.7% 0.245 27.325) 20%,transparent);color:oklch(50.5% 0.213 27.518);}:host-context(.dark) .ds-danger{color:oklch(80.8% 0.114 19.571);}.ds-caution{background:color-mix(in oklab,oklch(55.5% 0.163 48.998) 8%,transparent);border-color:color-mix(in oklab,oklch(55.5% 0.163 48.998) 20%,transparent);color:oklch(47.3% 0.137 46.201);}:host-context(.dark) .ds-caution{color:oklch(87.9% 0.169 91.605);}"
    },
    {
      "name": "Content card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered container used for installation and review information.",
      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Connected installations</h3><p class=\"ds-card-copy\">Install the app on GitHub, then connect the installation below.</p></section>",
      "css": ".ds-card{font-family:'Inter Variable',sans-serif;padding:20px;border:1px solid var(--border, #dce1d9);border-radius:calc(var(--radius,8px) + 2px);background:var(--card, #ffffff);color:var(--card-foreground, #202c26);}.ds-card-title{margin:0 0 12px;font-size:14px;line-height:20px;font-weight:600;}.ds-card-copy{margin:0;font-size:14px;line-height:20px;color:var(--muted-foreground, #606a62);}"
    },
    {
      "name": "Editable filter chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "URL-backed selections use separate edit and remove buttons; long summaries truncate within the available width.",
      "html": "<div class=\"ds-filter-chip\"><button class=\"ds-filter-edit\" aria-label=\"Edit PR state: Open, Merged\" aria-haspopup=\"dialog\" aria-expanded=\"false\"><span>PR state</span><span class=\"ds-filter-divider\" aria-hidden=\"true\"></span><span class=\"ds-filter-summary\">Open, Merged</span><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button class=\"ds-filter-remove\" aria-label=\"Remove PR state filter\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div>",
      "css": ".ds-filter-chip{display:inline-flex;align-items:center;max-width:100%;border-radius:var(--radius,8px);background:var(--accent, #e1ebe2);color:var(--accent-foreground, #173e2a);}.ds-filter-edit,.ds-filter-remove{display:inline-flex;align-items:center;justify-content:center;height:36px;border:0;background:transparent;color:inherit;font-family:\"Inter Variable\",sans-serif;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1);}.ds-filter-edit{min-width:0;gap:8px;padding:0 12px;border-radius:var(--radius,8px) 0 0 var(--radius,8px);}.ds-filter-edit>span:first-child,.ds-filter-edit svg{flex-shrink:0;}.ds-filter-divider{height:16px;border-left:1px solid color-mix(in oklab,currentColor 20%,transparent);}.ds-filter-summary{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-filter-remove{width:36px;flex-shrink:0;padding:0;border-left:1px solid color-mix(in oklab,currentColor 10%,transparent);border-radius:0 var(--radius,8px) var(--radius,8px) 0;}.ds-filter-edit:hover,.ds-filter-remove:hover{background:var(--accent, #e1ebe2);color:var(--accent-foreground, #173e2a);}.ds-filter-edit:focus-visible,.ds-filter-remove:focus-visible{outline:2px solid var(--ring, #377c59);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}@media(prefers-reduced-motion:reduce){.ds-filter-edit,.ds-filter-remove{transition-duration:.01ms;}}"
    },
    {
      "name": "Filter popover",
      "kind": "custom",
      "refersTo": "popover",
      "description": "Shared Radix popover surface for searchable filter choices, with an 8px trigger offset, 16px collision padding, and native checkboxes. This preview shows its content.",
      "html": "<section class=\"ds-filter-popover\" aria-label=\"Filter by PR state\"><p class=\"ds-filter-title\">PR state</p><div class=\"ds-filter-options\" role=\"group\" aria-label=\"PR state\"><label class=\"ds-filter-option\"><input type=\"checkbox\" checked><span>Open</span></label><label class=\"ds-filter-option\"><input type=\"checkbox\" checked><span>Merged</span></label><label class=\"ds-filter-option\"><input type=\"checkbox\"><span>Closed</span></label></div></section>",
      "css": ".ds-filter-popover{box-sizing:border-box;width:288px;max-width:calc(100vw - 2rem);padding:8px;border-radius:var(--radius,8px);background:var(--popover, #ffffff);color:var(--popover-foreground, #202c26);font-family:\"Inter Variable\",sans-serif;box-shadow:0 0 0 1px var(--border, #dce1d9),0 4px 6px -1px rgb(0 0 0 / .1),0 2px 4px -2px rgb(0 0 0 / .1);}.ds-filter-title{margin:0;padding:8px;font-size:14px;line-height:20px;font-weight:500;}.ds-filter-options{max-height:256px;overflow-y:auto;}.ds-filter-option{box-sizing:border-box;display:flex;align-items:center;gap:12px;min-height:40px;padding:8px;border-radius:calc(var(--radius,8px) - 2px);font-size:14px;line-height:20px;cursor:pointer;}.ds-filter-option input{width:16px;height:16px;margin:0;flex-shrink:0;accent-color:var(--primary, #245944);}.ds-filter-option:hover{background:var(--accent, #e1ebe2);}.ds-filter-option:has(:focus-visible){box-shadow:0 0 0 2px var(--ring, #377c59);}.ds-filter-option input:focus-visible{outline:2px solid var(--ring, #377c59);outline-offset:3px;}"
    }
