  "graph_defaults": {"max_files": 1000, "max_file_bytes": 1048576, "max_source_bytes": 8388608},
  "graph_maxima": {"max_files": 5000, "max_file_bytes": 4194304, "max_source_bytes": 33554432},
  "paths": [
