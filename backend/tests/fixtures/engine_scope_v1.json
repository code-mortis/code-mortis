    {"id": "noncanonical", "path": "./src/app.py", "eligible": false},
    {"id": "control", "path": "src/bad\u0000name.py", "eligible": false},
    {"id": "additional-directory", "path": "fixtures/app.py", "exclusions": "fixtures", "eligible": false},
    {"id": "additional-glob", "path": "docs/page.mdx", "exclusions": "docs/**", "eligible": false},
    {"id": "custom-case-preserved", "path": "Docs/page.mdx", "exclusions": "docs/**", "eligible": true},
    {"id": "root-glob", "path": "test_app.py", "exclusions": "**/test_*.py", "eligible": false}
  ],
  "graph_cases": [
    {
      "id": "exact-count-and-bytes-with-oversized",
      "limits": {"max_files": 2, "max_file_bytes": 4, "max_source_bytes": 8},
      "files": {"a.py": "# a\n", "b.py": "# b\n", "big.py": "# big\n"},
      "sources": ["a.py", "b.py"],
      "exclusions": {"big.py": "file_too_large"},
      "unsupported": []
    },
    {
      "id": "metadata-does-not-consume-parser-budget",
      "limits": {"max_files": 1, "max_file_bytes": 4, "max_source_bytes": 4},
      "files": {"a.py": "# a\n", "README.md": "documentation exceeds four bytes", "guide.mdx": "<Component />", "image.SVG": "media exceeds four bytes", "package-lock.json": "{}"},
      "sources": ["a.py"],
      "exclusions": {"image.SVG": "excluded", "package-lock.json": "excluded"},
      "unsupported": ["README.md", "guide.mdx"]
    },
    {
      "id": "additional-exclusion-before-admission",
      "limits": {"max_files": 1, "max_file_bytes": 4, "max_source_bytes": 4},
      "additional_exclusions": "fixtures/**",
      "files": {"a.py": "# a\n", "fixtures/b.py": "# b\n"},
      "sources": ["a.py"],
      "exclusions": {"fixtures/b.py": "excluded"},
      "unsupported": []
    },
    {
      "id": "count-failure",
      "limits": {"max_files": 1, "max_file_bytes": 4, "max_source_bytes": 8},
      "files": {"a.py": "# a\n", "b.py": "# b\n"},
      "failure": "file_count", "measurements": {"actual": 2, "limit": 1}
    },
    {
      "id": "total-byte-failure",
      "limits": {"max_files": 2, "max_file_bytes": 4, "max_source_bytes": 7},
      "files": {"a.py": "# a\n", "b.py": "# b\n"},
      "failure": "source_size", "measurements": {"actual": 8, "limit": 7}
    },
    {
      "id": "all-excluded-is-empty-admission",
      "limits": {"max_files": 1, "max_file_bytes": 4, "max_source_bytes": 4},
      "files": {"AGENTS.md": "untrusted instructions", "password_reset.py": "# ordinary source\n"},
      "sources": [],
      "exclusions": {"AGENTS.md": "excluded", "password_reset.py": "excluded"},
      "unsupported": []
    }
  ],
  "review_gates": [
    {"id": "exact", "selected_count": 40, "maximum": 40, "skipped": false},
    {"id": "over", "selected_count": 41, "maximum": 40, "skipped": true},
    {"id": "unlimited", "selected_count": 41, "maximum": null, "skipped": false},
    {"id": "empty", "selected_count": 0, "maximum": 1, "skipped": false}
  ]
}
