      "html": "<button type=\"button\" class=\"ds-button-destructive\">Delete connection</button>",
      "css": ".ds-button-destructive{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--destructive, #b32d37);color:#fff;}.ds-button-destructive:hover{background:color-mix(in oklab,var(--destructive, #b32d37) 90%,transparent);}.ds-button-destructive:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive, #b32d37) 20%,transparent);}.ds-button-destructive:disabled{pointer-events:none;opacity:.5;}:host-context(.dark) .ds-button-destructive{background:color-mix(in oklab,var(--destructive, #b32d37) 60%,transparent);}@media(prefers-reduced-motion:reduce){.ds-button-destructive{transition-duration:0.01ms;animation-duration:0.01ms;}}"
    },
    {
