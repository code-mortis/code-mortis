      "html": "<button type=\"button\" class=\"ds-button-outline\">Dismiss</button>",
      "css": ".ds-button-outline{font-family:'Inter Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;height:36px;padding:8px 16px;border:0 solid transparent;border-radius:var(--radius,8px);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);border-width:1px;border-color:var(--border, #dce1d9);background:var(--background, #f7f8f5);color:var(--foreground, #202c26);box-shadow:0 1px 2px 0 rgb(0 0 0 / .05);}.ds-button-outline:hover{background:var(--accent, #e1ebe2);color:var(--accent-foreground, #173e2a);}.ds-button-outline:focus-visible{outline:none;border-color:var(--ring, #377c59);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring, #377c59) 50%,transparent);}.ds-button-outline:disabled{pointer-events:none;opacity:.5;}:host-context(.dark) .ds-button-outline{border-color:var(--input, #c5cec3);background:color-mix(in oklab,var(--input, #c5cec3) 30%,transparent);}:host-context(.dark) .ds-button-outline:hover{background:color-mix(in oklab,var(--input, #c5cec3) 50%,transparent);}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition-duration:0.01ms;animation-duration:0.01ms;}}"
    },
