# Generate real values with: python3 backend/code_mortis/manage.py init-env --owner YOUR_GITHUB_LOGIN --url https://reviews.example.com
CM_PUBLIC_URL=http://localhost:8080
CM_OWNER_GITHUB_LOGIN=YOUR_GITHUB_LOGIN
CM_ENCRYPTION_KEY=GENERATE_WITH_INIT_ENV
CM_BOOTSTRAP_TOKEN=GENERATE_WITH_INIT_ENV
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
CM_COOKIE_SECURE=false
CM_PORT=8080
# Only administrators can set provider URLs. Enable private endpoints only on trusted deployments.
CM_ALLOW_PRIVATE_ENDPOINTS=false
# Optional comma-separated explicit host allowlist, for example host.docker.internal for a local gateway.
CM_TRUSTED_ENDPOINT_HOSTS=
