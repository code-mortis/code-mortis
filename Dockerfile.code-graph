FROM python:3.13-slim@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS parser
COPY --from=ghcr.io/astral-sh/uv:0.9.14 /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --only-group code-graph --no-install-project --no-cache
COPY backend/code_mortis/__init__.py ./code_mortis/__init__.py
COPY backend/code_mortis/schemas/__init__.py backend/code_mortis/schemas/code_graph.py ./code_mortis/schemas/
COPY backend/code_mortis/code_graph/ ./code_mortis/code_graph/
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
ENTRYPOINT ["sh", "-ec", ": \"${CM_CODE_GRAPH_TOKEN:?Run upgrade-env before enabling code-graph}\"; exec \"$@\"", "--"]
CMD ["uvicorn", "code_mortis.code_graph.server:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1", "--http", "h11", "--ws", "none", "--lifespan", "off", "--limit-concurrency", "8", "--no-access-log"]

# Disposable HTTP client for container checks; never used by the parser service.
FROM parser AS checks
USER root
RUN uv sync --frozen --no-dev --no-install-project --no-cache
USER 65534:65534

FROM parser AS runtime
